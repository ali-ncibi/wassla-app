# Postgres user for the local db service
POSTGRES_USER=wassla
# Postgres password for the local db service (dev only, gitignored)
POSTGRES_PASSWORD=changeme
# Postgres database created on first boot
POSTGRES_DB=wassla

# Pipeline DB connection inside the compose network (host 'db' = db service; use localhost for host-side runs)
DATABASE_URL=postgresql://wassla:changeme@db:5432/wassla

# Active LLM provider: mistral | openai | stub
LLM_PROVIDER=mistral
# Mistral AI Cloud API key (required when LLM_PROVIDER=mistral)
MISTRAL_API_KEY=your-mistral-api-key
# Mistral OpenAI-compatible API base URL
MISTRAL_BASE_URL=https://api.mistral.ai/v1
# OpenAI API key (required when LLM_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key
# OpenAI API base URL
OPENAI_BASE_URL=https://api.openai.com/v1
# Model used by the translation agent
MODEL_TRANSLATE=mistral-small-latest
# Model used by the categorization agent
MODEL_CATEGORIZE=mistral-small-latest
# Model used by the summarization agent
MODEL_SUMMARIZE=mistral-small-latest
# Model used by the independent evaluator (QA scoring) agent
MODEL_EVALUATOR=mistral-medium-latest
# Chat model used when LLM_PROVIDER=openai
MODEL_OPENAI=gpt-4o-mini
# Sampling temperature for all LLM calls
LLM_TEMPERATURE=0.2
# HTTP timeout for LLM API calls, in seconds
LLM_TIMEOUT_SECONDS=90
# Max concurrent LLM calls across the pipeline
LLM_MAX_CONCURRENCY=4

# Active embeddings provider: mistral | openai | stub
EMBEDDING_PROVIDER=mistral
# Embedding model (its vector size must match EMBEDDING_DIM)
MISTRAL_EMBEDDING_MODEL=mistral-embed
# Embedding vector dimension (pgvector column size; the stub provider matches it)
EMBEDDING_DIM=1024
# HTTP timeout for embedding API calls, in seconds
EMBEDDING_TIMEOUT_SECONDS=60

# Comma-separated target languages for translations and summaries
LANGUAGES=en,fr,ar
# Comma-separated allowed news categories
CATEGORIES=world,politics,business,technology,science,health,sports,culture,environment
# Secret token required in the X-Ingest-Token header to call POST /ingest/run (generate: openssl rand -hex 32)
INGEST_TOKEN=generate-with-openssl-rand-hex-32
# Max bytes accepted from a single RSS feed response
MAX_FEED_BYTES=5000000
# Max redirects followed per feed, only to hosts present in the sources table
MAX_FEED_REDIRECTS=3
# Max new articles processed per ingest run
INGEST_MAX_ITEMS=50
# Evaluator score below which an article is flagged needs_review
EVAL_MIN_SCORE=6.0
# Max article body characters kept from a feed entry
MAX_BODY_CHARS=12000
# HTTP timeout for RSS feed fetches, in seconds
RSS_TIMEOUT_SECONDS=30
# User-Agent header sent when fetching RSS feeds
RSS_USER_AGENT=WasslaNewsBot/1.0

# Default number of results returned by RAG search
RAG_TOP_K=5
# Minimum cosine similarity (0-1) for a RAG hit to be returned
RAG_MIN_SCORE=0.35
# Whether RAG search also generates a grounded LLM answer with citations
RAG_ANSWER_ENABLED=true

# Comma-separated origins allowed to call the pipeline API directly (the web app uses its same-origin proxy)
CORS_ORIGINS=http://localhost:3000

# Base URL the web server-side proxy uses to reach the pipeline (compose service name)
NUXT_API_BASE=http://pipeline:8000

# Phoenix project name for traces and eval experiments (the Phoenix server runs with `make up`, UI at http://localhost:6006; see documentation/observability.md)
PHOENIX_PROJECT_NAME=wassla-pipeline
